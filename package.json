{
  "name": "qhop",
  "displayName": "qhop",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "qhop.deletePartBeforeUppercase",
        "title": "Delete Part Before Uppercase"
      },
      {
          "command": "qhop.deletePartAfterUppercase",
          "title": "Delete Part After Uppercase"
      },
      {
          "command": "qhop.moveToNextUppercase",
          "title": "Move to Next Uppercase"
      },
      {
          "command": "qhop.moveToPreviousUppercase",
          "title": "Move to Previous Uppercase"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.91.0",
    "@types/node": "20.x",
    "typescript": "^5.4.5"
  }
}
